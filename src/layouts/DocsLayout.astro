---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Frontmatter {
  title?: string;
  description?: string;
  /** Path to this docs page relative to repo root, for the "improve on GitHub" link.
   *  Defaults to src/pages/docs.mdx. */
  editPath?: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: Frontmatter;
  headings: Heading[];
}

const { frontmatter, headings } = Astro.props;

const title = frontmatter.title ?? "Docs";
const description =
  frontmatter.description ??
  "Build instructions, configuration reference, internals, and contributor notes for AppGrid.";
const editPath = frontmatter.editPath ?? "src/pages/docs.mdx";
const editUrl = `https://github.com/xarbit/appgrid.xarbit.dev/edit/main/${editPath}`;

// TOC = top-level H2s only. H3s appear as subsections under their parent H2.
const tocEntries = headings.filter((h) => h.depth === 2);
---

<Layout title={`${title} — AppGrid for Plasma`} description={description}>
  <Navbar />

  <main id="main" class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <article class="docs-prose">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3">{title}</h1>
      {frontmatter.description && (
        <p class="text-lg text-[var(--fg-muted)] mb-10">{frontmatter.description}</p>
      )}

      {tocEntries.length > 0 && (
        <nav aria-label="Table of contents" class="breeze-card p-5 mb-12 not-prose">
          <p class="text-xs uppercase tracking-wider text-[var(--fg-muted)] font-medium mb-3">On this page</p>
          <ul class="grid sm:grid-cols-2 gap-y-1.5 gap-x-6 text-sm">
            {tocEntries.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-[var(--fg-body)] hover:text-[#3daee9] transition-colors">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <slot />

      <div class="mt-12 pt-6 border-t border-[var(--border)]/50 flex flex-wrap items-center justify-between gap-4 text-sm not-prose">
        <a href="/" class="text-[var(--fg-muted)] hover:text-[var(--fg)]">← Back to the home page</a>
        <a
          href={editUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[var(--fg-muted)] hover:text-[#3daee9] transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
          Found an issue with this page? Improve it on GitHub →
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Scoped to .docs-prose so it doesn't leak into other pages. Tailwind
     handles utility classes in the body content; this styles the raw
     HTML elements that MDX emits (h2/h3, p, ul, ol, code, pre, etc.).
     Written in plain CSS — Tailwind v4 doesn't expand @apply inside
     Astro <style is:global> without an explicit @reference directive. */
  .docs-prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .docs-prose h2 {
      font-size: 1.875rem;
      line-height: 2.25rem;
    }
  }
  .docs-prose h3 {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5rem;
  }
  .docs-prose p {
    color: var(--fg-body);
    line-height: 1.625;
    margin-bottom: 1rem;
  }
  .docs-prose ul,
  .docs-prose ol {
    color: var(--fg-body);
    line-height: 1.625;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .docs-prose ul { list-style: disc; }
  .docs-prose ol { list-style: decimal; }
  .docs-prose li {
    margin-top: 0.375rem;
    margin-bottom: 0.375rem;
  }
  .docs-prose li > p {
    margin-bottom: 0;
  }
  .docs-prose strong {
    color: var(--fg);
    font-weight: 600;
  }
  .docs-prose a {
    color: #3daee9;
  }
  .docs-prose a:hover {
    text-decoration: underline;
  }
  .docs-prose :not(pre) > code {
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background: var(--canvas-deep);
    border: 1px solid var(--border);
    color: var(--fg);
  }
  .docs-prose pre {
    border-radius: 0.5rem;
    padding: 1rem;
    margin: 1rem 0;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.625;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background: var(--canvas-deep);
    border: 1px solid var(--border);
    color: var(--fg);
  }
  .docs-prose pre code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 0.875rem;
  }
  .docs-prose table {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .docs-prose thead tr {
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .docs-prose th {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    font-weight: 600;
  }
  .docs-prose tbody tr {
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .docs-prose tbody tr:last-child {
    border-bottom: 0;
  }
  .docs-prose td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    vertical-align: top;
  }
  .docs-prose hr {
    margin: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .docs-prose blockquote {
    padding: 0.25rem 0 0.25rem 1rem;
    margin: 1rem 0;
    font-style: italic;
    border-left: 3px solid var(--border);
    color: var(--fg-muted);
  }
</style>
