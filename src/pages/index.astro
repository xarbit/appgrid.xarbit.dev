---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import WhatsNew from "../components/WhatsNew.astro";
import Features from "../components/Features.astro";
import GallerySection from "../components/GallerySection.astro";
import Shortcuts from "../components/Shortcuts.astro";
import Install from "../components/Install.astro";
import Contribute from "../components/Contribute.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
---

<Layout includeAppSchema>
  <Navbar />
  <main id="main">
    <Hero />
    <WhatsNew />
    <Features />
    <GallerySection />
    <Shortcuts />
    <Install />
    <Contribute />
    <FAQ />
  </main>
  <Footer />
  <StickyCTA />
</Layout>
