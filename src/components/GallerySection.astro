---
import { getImage } from "astro:assets";
import Gallery from "./Gallery";

import launcherCenterDefault from "../assets/screenshots/launcher-center-default.png";
import launcherMain from "../assets/screenshots/launcher-main.png";
import launcherMainDark from "../assets/screenshots/launcher-main-dark.png";
import launcherNative from "../assets/screenshots/launcher-native-popup.png";
import contextMenu from "../assets/screenshots/launcher-context-menu-dark.png";
import search from "../assets/screenshots/search.png";
import quickCommands from "../assets/screenshots/quick-commands.png";
import settings from "../assets/screenshots/settings.png";
import sortCategory from "../assets/screenshots/sort-category-view.png";
import hiddenApps from "../assets/screenshots/hidden-apps.png";
import info from "../assets/screenshots/info.png";

const sources = [
  { img: launcherCenterDefault, alt: "Center variant on Plasma 6 desktop" },
  { img: launcherMain, alt: "Main launcher view" },
  { img: launcherMainDark, alt: "Dark theme" },
  { img: launcherNative, alt: "Native panel popup variant" },
  { img: contextMenu, alt: "Right-click context menu with jumplist actions" },
  { img: search, alt: "Unified search results" },
  { img: quickCommands, alt: "Quick commands help" },
  { img: sortCategory, alt: "Sort by category view" },
  { img: settings, alt: "Settings panel" },
  { img: hiddenApps, alt: "Hidden apps manager" },
  { img: info, alt: "System info command" },
];

const items = await Promise.all(
  sources.map(async (s) => {
    const fullW = Math.min(s.img.width, 1920);
    // Encode each image as both AVIF (preferred — ~30-50% smaller)
    // and WebP (fallback). The Gallery React island picks via <picture>.
    const [thumbAvif, thumbWebp, fullAvif, fullWebp] = await Promise.all([
      getImage({ src: s.img, width: 800, format: "avif", quality: 60 }),
      getImage({ src: s.img, width: 800, format: "webp", quality: 75 }),
      getImage({ src: s.img, width: fullW, format: "avif", quality: 70 }),
      getImage({ src: s.img, width: fullW, format: "webp", quality: 88 }),
    ]);
    return {
      thumbAvif: thumbAvif.src,
      thumb: thumbWebp.src,
      fullAvif: fullAvif.src,
      full: fullWebp.src,
      alt: s.alt,
      width: s.img.width,
      height: s.img.height,
    };
  }),
);
---

<section id="screenshots" class="py-20 md:py-28 border-t border-[var(--border)]/50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
        See it in action
      </h2>
      <p class="text-lg text-[var(--fg-muted)]">
        Click any screenshot to enlarge. Arrow keys to navigate.
      </p>
    </div>

    <Gallery client:visible items={items} />
  </div>
</section>
