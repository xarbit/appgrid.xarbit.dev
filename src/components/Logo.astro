---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
const gradId = `appgrid-logo-grad-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3daee9"></stop>
      <stop offset="100%" stop-color="#1d99f3"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill={`url(#${gradId})`}></rect>
  <rect x="12" y="12" width="16" height="16" rx="3" fill="white"></rect>
  <rect x="36" y="12" width="16" height="16" rx="3" fill="white"></rect>
  <rect x="12" y="36" width="16" height="16" rx="3" fill="white"></rect>
  <rect x="36" y="36" width="16" height="16" rx="3" fill="white"></rect>
</svg>
