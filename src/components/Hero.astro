---
import { Image } from "astro:assets";
import heroLight from "../assets/screenshots/launcher-main.png";
import heroDark from "../assets/screenshots/launcher-main-dark.png";
import {
  primary,
  mirrors,
  repoUrl,
  fetchLatestVersion,
  fetchLatestPrerelease,
  fetchStars,
  formatStars,
} from "../config/repo";

const stable = await fetchLatestVersion(primary);
const prerelease = await fetchLatestPrerelease(primary);
const starsCount = await fetchStars(primary);
const starsLabel = starsCount !== null ? formatStars(starsCount) : null;

// Distros we package for (count by hand to match install section).
const distrosPackaged = 6; // Arch, Fedora, Ubuntu, Debian, openSUSE, Gentoo
const distrosImmutable = 6; // KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS
---

<section class="relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-6">
        {
          stable && (
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3daee9]/10 border border-[#3daee9]/30 text-[#93cee9] text-xs font-medium">
              <span class="w-2 h-2 rounded-full bg-[#3daee9] animate-pulse" />
              stable: v{stable}
            </span>
          )
        }
        {
          prerelease && (
            <a
              href={prerelease.htmlUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e67e22]/10 border border-[#e67e22]/40 text-[#f5a35e] text-xs font-medium hover:bg-[#e67e22]/20 transition-colors"
              title="Pre-release available — click for release notes"
            >
              <span class="w-2 h-2 rounded-full bg-[#e67e22] animate-pulse" />
              pre-release: v{prerelease.tag}
            </a>
          )
        }
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6"
      >
        Application launcher
        <span
          class="block bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
        >
          built for KDE Plasma 6
        </span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--fg-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
        A grid-style replacement for Kickoff and Kicker with unified search,
        KRunner integration and smooth animations. Packaged for Arch, Fedora,
        Ubuntu, Debian and openSUSE, plus a universal <code>~/.local/</code>
        tarball that runs on any Plasma 6.4+ system, immutable distros included
        (KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS).
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Install AppGrid
        </a>
        <a
          href={repoUrl(primary)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
          View on {primary.label}
        </a>
      </div>

      {
        mirrors.length > 0 && (
          <div class="mt-3 text-xs text-[var(--fg-muted)]">
            Also on{" "}
            {mirrors.map((m, i) => (
              <>
                {i > 0 && ", "}
                <a
                  href={repoUrl(m)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-[var(--fg)]"
                >
                  {m.label}
                </a>
              </>
            ))}
          </div>
        )
      }

      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto">
        {starsLabel && (
          <a
            href={repoUrl(primary)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[#f1c40f]/40 transition-colors group"
          >
            <div class="flex items-center gap-1.5 text-[#f4d03f]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">{starsLabel}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">{primary.label} stars</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#3daee9]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16.5 9.4 7.5 4.21" />
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
            <span class="font-semibold text-[var(--fg)] tabular-nums">{distrosPackaged + distrosImmutable}+</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">distros supported</span>
        </div>

        {stable && (
          <a
            href="#whats-new"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[var(--color-breeze-blue)]/40 transition-colors"
          >
            <div class="flex items-center gap-1.5 text-[#5fd48a]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">v{stable}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">latest stable</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#c084d6]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 12l2 2 4-4" />
              <circle cx="12" cy="12" r="10" />
            </svg>
            <span class="font-semibold text-[var(--fg)]">GPL-2.0</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">free &amp; open</span>
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20 relative">
      <div
        class="absolute -inset-x-10 -inset-y-6 bg-gradient-to-b from-[#3daee9]/20 via-[#9b59b6]/10 to-transparent blur-3xl -z-10"
      >
      </div>
      <Image
        src={heroDark}
        alt="AppGrid launcher (dark theme)"
        loading="eager"
        widths={[640, 960, 1280, 1920]}
        sizes="(max-width: 768px) 100vw, 1100px"
        class="hero-image hero-image--dark w-full h-auto block mx-auto drop-shadow-2xl"
      />
      <Image
        src={heroLight}
        alt="AppGrid launcher (light theme)"
        loading="lazy"
        widths={[640, 960, 1280, 1920]}
        sizes="(max-width: 768px) 100vw, 1100px"
        class="hero-image hero-image--light w-full h-auto block mx-auto drop-shadow-2xl"
      />
    </div>
  </div>
</section>

<style>
  /* Default (no theme attr) — show dark, swap based on system pref */
  .hero-image--light {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) ~ * .hero-image--dark,
    html:not([data-theme]) .hero-image--dark {
      display: none;
    }
    :root:not([data-theme]) ~ * .hero-image--light,
    html:not([data-theme]) .hero-image--light {
      display: block;
    }
  }
  /* Explicit theme overrides system pref */
  html[data-theme="dark"] .hero-image--dark {
    display: block;
  }
  html[data-theme="dark"] .hero-image--light {
    display: none;
  }
  html[data-theme="light"] .hero-image--dark {
    display: none;
  }
  html[data-theme="light"] .hero-image--light {
    display: block;
  }
</style>
