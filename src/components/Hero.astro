---
import { getImage } from "astro:assets";
import heroSpriteLight from "../assets/screenshots/hero-sprite-light.png";
import heroSpriteDark from "../assets/screenshots/hero-sprite-dark.png";

// Sprite contains 5 frames stacked vertically per theme.
// background-position-y in CSS steps between them — single DOM element,
// single animated property = atomic update each transition.
const [spriteLightAvif, spriteLightWebp, spriteDarkAvif, spriteDarkWebp] =
  await Promise.all([
    getImage({ src: heroSpriteLight, format: "avif", quality: 60, width: 1208 }),
    getImage({ src: heroSpriteLight, format: "webp", quality: 85, width: 1208 }),
    getImage({ src: heroSpriteDark, format: "avif", quality: 60, width: 1208 }),
    getImage({ src: heroSpriteDark, format: "webp", quality: 85, width: 1208 }),
  ]);
import BrandIcon from "./BrandIcon.astro";
import {
  primary,
  mirrors,
  repoUrl,
  fetchLatestRelease,
  fetchLatestPrerelease,
  fetchStars,
  formatStars,
} from "../config/repo";

const stable = await fetchLatestRelease(primary);
const prerelease = await fetchLatestPrerelease(primary);
const starsCount = await fetchStars(primary);
const starsLabel = starsCount !== null ? formatStars(starsCount) : null;

// Distros we package for (count by hand to match install section).
const distrosPackaged = 6; // Arch, Fedora, Ubuntu, Debian, openSUSE, Gentoo
const distrosImmutable = 6; // KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS

// Decorative scattered KDE app icons behind the headline — a launcher
// is a grid of apps, so this reinforces the concept. Breeze app icons
// (LGPL, KDE). `s` is px size, x/y are %, `rot` degrees. Biased to the
// sides so the headline stays readable; masked + faded so it never
// competes with the text.
const heroIcons = [
  { f: "dolphin", x: "4%", y: "16%", s: 76, rot: -10 },
  { f: "kate", x: "92%", y: "10%", s: 64, rot: 9 },
  { f: "juk", x: "16%", y: "60%", s: 58, rot: 7 },
  { f: "gwenview", x: "85%", y: "54%", s: 70, rot: -8 },
  { f: "okular", x: "10%", y: "38%", s: 52, rot: 6 },
  { f: "spectacle", x: "95%", y: "30%", s: 56, rot: -6 },
  { f: "kdenlive", x: "2%", y: "70%", s: 60, rot: 11 },
  { f: "elisa", x: "78%", y: "78%", s: 50, rot: 8 },
  { f: "systemsettings", x: "23%", y: "12%", s: 48, rot: -7 },
  { f: "plasmadiscover", x: "70%", y: "14%", s: 46, rot: 6 },
  { f: "ark", x: "88%", y: "84%", s: 44, rot: -9 },
  { f: "kcalc", x: "12%", y: "86%", s: 46, rot: 5 },
  { f: "kmail", x: "30%", y: "82%", s: 42, rot: -6 },
  { f: "kontact", x: "63%", y: "62%", s: 44, rot: 7 },
  { f: "kdevelop", x: "37%", y: "8%", s: 40, rot: -5 },
  { f: "filelight", x: "60%", y: "86%", s: 40, rot: 9 },
  { f: "digikam", x: "47%", y: "64%", s: 42, rot: -8 },
  { f: "kwrite", x: "52%", y: "10%", s: 38, rot: 6 },
];
---

<section class="relative overflow-hidden">
  <!-- Decorative scattered KDE app icons behind the headline. Purely
       visual — masked + faded so it never reduces headline legibility. -->
  <div class="hero-icons" aria-hidden="true">
    {
      heroIcons.map((i) => (
        <img
          src={`/kde-icons/${i.f}.svg`}
          alt=""
          loading="lazy"
          decoding="async"
          class="hero-icons__app"
          style={`left:${i.x};top:${i.y};width:${i.s}px;height:${i.s}px;--rot:${i.rot}deg;`}
        />
      ))
    }
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-6">
        {
          stable && (
            <a
              href={stable.htmlUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3daee9]/10 border border-[#3daee9]/30 text-[#93cee9] text-xs font-medium hover:bg-[#3daee9]/20 transition-colors"
              title="Latest stable — click for release notes"
            >
              <span class="w-2 h-2 rounded-full bg-[#3daee9] animate-pulse" />
              stable: v{stable.tag}
            </a>
          )
        }
        {
          prerelease && (
            <a
              href={prerelease.htmlUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e67e22]/10 border border-[#e67e22]/40 text-[#f5a35e] text-xs font-medium hover:bg-[#e67e22]/20 transition-colors"
              title="Pre-release available — click for release notes"
            >
              <span class="w-2 h-2 rounded-full bg-[#e67e22] animate-pulse" />
              pre-release: v{prerelease.tag}
            </a>
          )
        }
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6"
      >
        Application launcher,
        <span class="block">
          <span
            class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
          >
            native to
          </span>
          <span class="inline-flex items-center gap-3 align-middle">
            <BrandIcon
              slug="kdeplasma"
              size={56}
              brandColor
              title="KDE Plasma"
              class="hero-kde-mark"
            />
            <span
              class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
            >
              KDE Plasma 6
            </span>
          </span>
        </span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--fg-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
        Not an app bolted onto your desktop — a native Plasma plasmoid, an
        alternative to Kickoff and Kicker. Every app on a searchable grid,
        KRunner built in. Open source, no account, no telemetry.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Install AppGrid
        </a>
        <a
          href={repoUrl(primary)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
          View on {primary.label}
        </a>
      </div>

      {
        mirrors.length > 0 && (
          <div class="mt-3 text-xs text-[var(--fg-muted)]">
            Also on{" "}
            {mirrors.map((m, i) => (
              <>
                {i > 0 && ", "}
                <a
                  href={repoUrl(m)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-[var(--fg)]"
                >
                  {m.label}
                </a>
              </>
            ))}
          </div>
        )
      }

      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto">
        {starsLabel && (
          <a
            href={repoUrl(primary)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[#f1c40f]/40 transition-colors group"
          >
            <div class="flex items-center gap-1.5 text-[#f4d03f]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">{starsLabel}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">{primary.label} stars</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#3daee9]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16.5 9.4 7.5 4.21" />
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
            <span class="font-semibold text-[var(--fg)] tabular-nums">{distrosPackaged + distrosImmutable}+</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">distros supported</span>
        </div>

        {stable && (
          <a
            href={stable.htmlUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[var(--color-breeze-blue)]/40 transition-colors"
          >
            <div class="flex items-center gap-1.5 text-[#5fd48a]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">v{stable.tag}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">latest stable</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#c084d6]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 12l2 2 4-4" />
              <circle cx="12" cy="12" r="10" />
            </svg>
            <span class="font-semibold text-[var(--fg)]">GPL-2.0</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">free &amp; open</span>
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20 relative">
      <div
        class="absolute -inset-x-10 -inset-y-6 bg-gradient-to-b from-[#3daee9]/20 via-[#9b59b6]/10 to-transparent blur-3xl -z-10"
      >
      </div>
      <div
        class="hero-demo mx-auto drop-shadow-2xl"
        role="img"
        aria-label="AppGrid demo: typing 'term' in the search bar, then launching Ghostty"
        style={`--sprite-dark: image-set(url("${spriteDarkAvif.src}") type("image/avif"), url("${spriteDarkWebp.src}") type("image/webp")); --sprite-light: image-set(url("${spriteLightAvif.src}") type("image/avif"), url("${spriteLightWebp.src}") type("image/webp"));`}
      >
        <!-- Single-element sprite renderer per theme. Theme CSS hides
             the inactive layer. background-position-y steps through
             five frames stacked vertically in one source image. -->
        <div class="hero-sprite hero-sprite--dark"></div>
        <div class="hero-sprite hero-sprite--light"></div>

        <!-- Animation overlay. All coordinates are % of the rendered
             image bounds so they scale. Tune --search-* and --ghostty-*
             if the underlying screenshots change. -->
        <div class="hero-overlay" aria-hidden="true">
          <!-- Click pulse over Ghostty (first result row, Alt+1). -->
          <span class="hero-pulse hero-pulse--search"></span>
          <span class="hero-pulse hero-pulse--ghostty"></span>

          <!-- KDE Breeze cursor (breeze_cursors default pointer, LGPL):
               white body + dark interior. Drop shadow comes from the
               CSS filter on .hero-cursor. -->
          <svg class="hero-cursor" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
            <path
              d="m3.93 2.75a.9.9 0 0 0 -.362.072.93.93 0 0 0 -.568.73l.002 16.497a1 1 0 0 0 1.299.865l3.076-1.273 1.697 2.27a2.265 2.265 0 0 0 4.092-1.696l-.402-2.805 3.074-1.275q.135-.068.248-.18a1 1 0 0 0 .059-1.35l-11.663-11.665a.92.92 0 0 0 -.552-.189"
              fill="#fff"
            />
            <path
              d="m4 3.873-.004 15.977 3.352-1.766 2.271 2.73a1.402 1.402 0 0 0 2.389-.988l-.326-3.539 3.619-1.119z"
              fill="#232629"
            />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* H1 KDE Plasma brand mark — scale down on small viewports so it
     visually balances the smaller H1 font size. */
  .hero-kde-mark {
    width: 2.5rem;
    height: 2.5rem;
  }
  @media (min-width: 768px) {
    .hero-kde-mark {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  /* Scattered KDE app-icon decoration behind the headline. Covers the
     top text band only; a vertical mask fades it out before the demo
     image so nothing competes with the launcher screenshot. */
  .hero-icons {
    position: absolute;
    inset: 0 0 auto 0;
    height: 480px;
    z-index: 0;
    pointer-events: none;
    /* Two masks composited with `intersect`: the vertical fade keeps
       icons in the top band only; the centred radial punches a clear
       hole so no icon ever renders behind the headline text. */
    -webkit-mask-image:
      linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%),
      radial-gradient(ellipse 44% 34% at 50% 33%, transparent 32%, #000 78%);
    mask-image:
      linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%),
      radial-gradient(ellipse 44% 34% at 50% 33%, transparent 32%, #000 78%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (min-width: 768px) {
    .hero-icons {
      height: 620px;
    }
  }

  .hero-icons__app {
    position: absolute;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    opacity: 0.16;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
  }
  @media (min-width: 768px) {
    .hero-icons__app {
      opacity: 0.2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Static already — nothing to disable; kept for parity. */
    .hero-icons {
      height: 480px;
    }
  }

  /* ─────────────────────── Scripted hero demo ─────────────────────── */
  /* The five frames per theme are stacked inside .hero-demo and shown
     in sequence via per-frame opacity keyframes. Coordinates of the
     synthetic cursor + click pulses are % of the container so they
     scale at every responsive width. Tune --search-* / --ghostty-* if
     the underlying screenshots change. */
  .hero-demo {
    position: relative;
    width: 100%;
    max-width: 1208px;
    aspect-ratio: 1208 / 966;
    /* Container queries so child elements (cursor, pulses) can size
       in cqw — % of the demo's own width — and scale on every viewport. */
    container-type: inline-size;
    /* Search bar click target. */
    --search-x: 50%;
    --search-y: 3.5%;
    /* First result row centre (Ghostty after typing "term"). */
    --ghostty-x: 50%;
    --ghostty-y: 11%;
    /* Cursor offscreen start. */
    --start-x: 108%;
    --start-y: -8%;
  }

  /* Single-element CSS sprite. One sprite image per theme — five
     frames stacked vertically. background-position-y steps between
     them. One DOM element + one animated property = atomic update
     each transition, no possibility of multi-frame overlap or
     compounded shadows. */
  .hero-sprite {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    /* Sprite is 5× tall as one frame. Sized to 100% width × 500% height
       so each frame occupies 20% of the bg height, matching the
       container's aspect ratio. */
    background-size: 100% 500%;
    background-position: 0% 0%;
    animation: hero-sprite 9s steps(1, end) infinite;
  }

  /* Both sprites are always laid out and animating; the theme just
     toggles which one is visible via opacity. display: none would
     reset the animation on theme switch, so the newly-revealed
     sprite would jump back to frame 0 instead of picking up where
     the hidden one left off. */
  .hero-sprite--dark { background-image: var(--sprite-dark); opacity: 1; }
  .hero-sprite--light { background-image: var(--sprite-light); opacity: 0; }

  /* Default to dark; system pref toggles when no explicit theme set. */
  @media (prefers-color-scheme: light) {
    html:not([data-theme]) .hero-sprite--dark { opacity: 0; }
    html:not([data-theme]) .hero-sprite--light { opacity: 1; }
  }
  html[data-theme="dark"] .hero-sprite--dark { opacity: 1; }
  html[data-theme="dark"] .hero-sprite--light { opacity: 0; }
  html[data-theme="light"] .hero-sprite--dark { opacity: 0; }
  html[data-theme="light"] .hero-sprite--light { opacity: 1; }

  /* background-position-y in % maps over (bg-height - container-height).
     With bg-height = 5×, container = 1×, range = 4×. So:
       0%   → frame 0 (empty)
       25%  → frame 1 (t)
       50%  → frame 2 (te)
       75%  → frame 3 (ter)
       100% → frame 4 (term) */
  @keyframes hero-sprite {
    0% { background-position: 0% 0%; }
    22% { background-position: 0% 25%; }
    27% { background-position: 0% 50%; }
    32% { background-position: 0% 75%; }
    43% { background-position: 0% 100%; }
    94% { background-position: 0% 0%; }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Synthetic cursor — animate top/left so % resolves against the
     container, not the cursor itself. Size in cqw so the cursor
     scales with the demo width (so it doesn't look tiny in fullscreen
     and oversized on mobile). Clamp keeps it in a sane range. */
  .hero-cursor {
    position: absolute;
    top: var(--start-y);
    left: var(--start-x);
    /* cqw tracks the .hero-demo width (= the launcher screenshot's
       render width), so the cursor scales with the app on screen.
       Floor keeps it tappable-size on mobile; ceiling caps it on
       very wide layouts. */
    width: clamp(24px, 5.5cqw, 64px);
    height: clamp(24px, 5.5cqw, 64px);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
    animation: hero-cursor-path 9s cubic-bezier(0.6, 0.05, 0.4, 1) infinite;
  }

  @keyframes hero-cursor-path {
    /* Hold offscreen for the initial dwell (0–8%) */
    0%, 8% {
      top: var(--start-y);
      left: var(--start-x);
    }
    /* Enter and arrive at search bar by 22% — frame 1 (t) shows at 24% */
    22% {
      top: var(--search-y);
      left: var(--search-x);
    }
    /* Dwell at search bar while typing (22–55%) */
    55% {
      top: var(--search-y);
      left: var(--search-x);
    }
    /* Move down to Ghostty result row (arrives ~70%) */
    70% {
      top: var(--ghostty-y);
      left: var(--ghostty-x);
    }
    /* Click + dwell on Ghostty (70–86%) */
    86% {
      top: var(--ghostty-y);
      left: var(--ghostty-x);
    }
    /* Cursor exits the window (must complete BEFORE frame reset at 94%) */
    93%, 100% {
      top: var(--start-y);
      left: var(--start-x);
    }
  }

  /* Click pulse — two independent rings firing at search-bar click
     and at Ghostty click. */
  .hero-pulse {
    position: absolute;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 2px solid var(--color-breeze-blue, #3daee9);
    background: rgba(61, 174, 233, 0.18);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }

  .hero-pulse--search {
    left: var(--search-x);
    top: var(--search-y);
    width: 5%;
    animation: hero-pulse-anim 9s linear infinite;
    animation-delay: 1.98s;  /* fires at search-bar click (~22% of 9s) */
  }

  .hero-pulse--ghostty {
    left: var(--ghostty-x);
    top: var(--ghostty-y);
    width: 8%;
    animation: hero-pulse-anim 9s linear infinite;
    animation-delay: 6.3s;   /* fires at Ghostty click (~70% of 9s) */
  }

  @keyframes hero-pulse-anim {
    0% {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 0.9;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
  }

  /* Reduced motion — freeze on the empty state, hide cursor + pulses. */
  @media (prefers-reduced-motion: reduce) {
    .hero-sprite, .hero-cursor, .hero-pulse {
      animation: none !important;
    }
    .hero-sprite { background-position: 0% 0%; }
    .hero-pulse { opacity: 0; }
    .hero-cursor {
      top: var(--start-y);
      left: var(--start-x);
    }
  }
</style>
