---
import { getImage } from "astro:assets";
import heroSpriteLight from "../assets/screenshots/hero-sprite-light.png";
import heroSpriteDark from "../assets/screenshots/hero-sprite-dark.png";

// Sprite contains 5 frames stacked vertically per theme.
// background-position-y in CSS steps between them — single DOM element,
// single animated property = atomic update each transition.
const [spriteLightAvif, spriteLightWebp, spriteDarkAvif, spriteDarkWebp] =
  await Promise.all([
    getImage({ src: heroSpriteLight, format: "avif", quality: 60, width: 1208 }),
    getImage({ src: heroSpriteLight, format: "webp", quality: 85, width: 1208 }),
    getImage({ src: heroSpriteDark, format: "avif", quality: 60, width: 1208 }),
    getImage({ src: heroSpriteDark, format: "webp", quality: 85, width: 1208 }),
  ]);
import BrandIcon from "./BrandIcon.astro";

// Decorative scattered KDE app icons behind the headline — a launcher
// is a grid of apps, so this reinforces the concept. Breeze app icons
// (LGPL, KDE). `s` is px size, x/y are %, `rot` degrees. Biased to the
// sides so the headline stays readable; masked + faded so it never
// competes with the text.
const heroIcons = [
  { f: "dolphin", x: "4%", y: "16%", s: 76, rot: -10 },
  { f: "kate", x: "92%", y: "10%", s: 64, rot: 9 },
  { f: "juk", x: "16%", y: "60%", s: 58, rot: 7 },
  { f: "gwenview", x: "85%", y: "54%", s: 70, rot: -8 },
  { f: "okular", x: "10%", y: "38%", s: 52, rot: 6 },
  { f: "spectacle", x: "95%", y: "30%", s: 56, rot: -6 },
  { f: "kdenlive", x: "2%", y: "70%", s: 60, rot: 11 },
  { f: "elisa", x: "78%", y: "78%", s: 50, rot: 8 },
  { f: "systemsettings", x: "23%", y: "12%", s: 48, rot: -7 },
  { f: "plasmadiscover", x: "70%", y: "14%", s: 46, rot: 6 },
  { f: "ark", x: "88%", y: "84%", s: 44, rot: -9 },
  { f: "kcalc", x: "12%", y: "86%", s: 46, rot: 5 },
  { f: "kmail", x: "30%", y: "82%", s: 42, rot: -6 },
  { f: "kontact", x: "63%", y: "62%", s: 44, rot: 7 },
  { f: "kdevelop", x: "37%", y: "8%", s: 40, rot: -5 },
  { f: "filelight", x: "60%", y: "86%", s: 40, rot: 9 },
  { f: "digikam", x: "47%", y: "64%", s: 42, rot: -8 },
  { f: "kwrite", x: "52%", y: "10%", s: 38, rot: 6 },
];
---

<section class="relative overflow-hidden">
  <!-- Decorative scattered KDE app icons behind the headline. Purely
       visual — masked + faded so it never reduces headline legibility. -->
  <div class="hero-icons" aria-hidden="true">
    {
      heroIcons.map((i) => (
        <img
          src={`/kde-icons/${i.f}.svg`}
          alt=""
          loading="lazy"
          decoding="async"
          class="hero-icons__app"
          data-depth={(i.s / 76) * 0.55}
          style={`left:${i.x};top:${i.y};width:${i.s}px;height:${i.s}px;--rot:${i.rot}deg;`}
        />
      ))
    }
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="text-center max-w-3xl mx-auto">
      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6"
      >
        Launch anything.
        <span class="block">
          <span
            class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
          >
            Native to
          </span>
          <span class="inline-flex items-center gap-3 align-middle">
            <BrandIcon
              slug="kdeplasma"
              size={56}
              brandColor
              title="KDE Plasma"
              class="hero-kde-mark"
            />
            <span
              class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
            >
              Plasma.
            </span>
          </span>
        </span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--fg-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
        Lightning-fast, focused &amp; beautiful<br />application launcher — for everyone.
      </p>

    </div>

    <div class="mt-16 md:mt-20 relative">
      <div
        class="hero-glow absolute -inset-x-10 -inset-y-6 bg-gradient-to-b from-[#3daee9]/20 via-[#9b59b6]/10 to-transparent blur-3xl -z-10"
        data-depth="-0.14"
      >
      </div>
      <div
        class="hero-demo mx-auto drop-shadow-2xl"
        role="img"
        aria-label="AppGrid demo: typing 'term' in the search bar, then launching Ghostty"
        style={`--sprite-dark: image-set(url("${spriteDarkAvif.src}") type("image/avif"), url("${spriteDarkWebp.src}") type("image/webp")); --sprite-light: image-set(url("${spriteLightAvif.src}") type("image/avif"), url("${spriteLightWebp.src}") type("image/webp"));`}
      >
        <!-- Single-element sprite renderer per theme. Theme CSS hides
             the inactive layer. background-position-y steps through
             five frames stacked vertically in one source image. -->
        <div class="hero-sprite hero-sprite--dark"></div>
        <div class="hero-sprite hero-sprite--light"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* H1 KDE Plasma brand mark — scale down on small viewports so it
     visually balances the smaller H1 font size. */
  .hero-kde-mark {
    width: 2.5rem;
    height: 2.5rem;
  }
  @media (min-width: 768px) {
    .hero-kde-mark {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  /* Scattered KDE app-icon decoration behind the headline. Covers the
     top text band only; a vertical mask fades it out before the demo
     image so nothing competes with the launcher screenshot. */
  .hero-icons {
    position: absolute;
    inset: 0 0 auto 0;
    height: 480px;
    z-index: 0;
    pointer-events: none;
    /* Two masks composited with `intersect`: the vertical fade keeps
       icons in the top band only; the centred radial punches a clear
       hole so no icon ever renders behind the headline text. */
    -webkit-mask-image:
      linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%),
      radial-gradient(ellipse 44% 34% at 50% 33%, transparent 32%, #000 78%);
    mask-image:
      linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%),
      radial-gradient(ellipse 44% 34% at 50% 33%, transparent 32%, #000 78%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (min-width: 768px) {
    .hero-icons {
      height: 620px;
    }
  }

  .hero-icons__app {
    position: absolute;
    /* --py is the scroll-parallax offset set per icon by the script
       below; composes with the centring + rotation. */
    transform: translate(-50%, calc(-50% + var(--py, 0px))) rotate(var(--rot, 0deg));
    opacity: 0.16;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* Hero glow drifts opposite the icons for a touch of depth. */
  .hero-glow {
    transform: translateY(var(--py, 0px));
    will-change: transform;
  }
  @media (min-width: 768px) {
    .hero-icons__app {
      opacity: 0.2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Static already — nothing to disable; kept for parity. */
    .hero-icons {
      height: 480px;
    }
  }

  /* ─────────────────────── Scripted hero demo ─────────────────────── */
  /* The five frames per theme are stacked inside .hero-demo and shown
     in sequence by stepping background-position-y, scaling at every
     responsive width. */
  .hero-demo {
    position: relative;
    width: 100%;
    max-width: 820px;
    aspect-ratio: 1208 / 966;
  }

  /* Single-element CSS sprite. One sprite image per theme — five
     frames stacked vertically. background-position-y steps between
     them. One DOM element + one animated property = atomic update
     each transition, no possibility of multi-frame overlap or
     compounded shadows. */
  .hero-sprite {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    /* Sprite is 5× tall as one frame. Sized to 100% width × 500% height
       so each frame occupies 20% of the bg height, matching the
       container's aspect ratio. */
    background-size: 100% 500%;
    background-position: 0% 0%;
    animation: hero-sprite 9s steps(1, end) infinite;
  }

  /* Both sprites are always laid out and animating; the theme just
     toggles which one is visible via opacity. display: none would
     reset the animation on theme switch, so the newly-revealed
     sprite would jump back to frame 0 instead of picking up where
     the hidden one left off. */
  .hero-sprite--dark { background-image: var(--sprite-dark); opacity: 1; }
  .hero-sprite--light { background-image: var(--sprite-light); opacity: 0; }

  /* Default to dark; system pref toggles when no explicit theme set. */
  @media (prefers-color-scheme: light) {
    html:not([data-theme]) .hero-sprite--dark { opacity: 0; }
    html:not([data-theme]) .hero-sprite--light { opacity: 1; }
  }
  html[data-theme="dark"] .hero-sprite--dark { opacity: 1; }
  html[data-theme="dark"] .hero-sprite--light { opacity: 0; }
  html[data-theme="light"] .hero-sprite--dark { opacity: 0; }
  html[data-theme="light"] .hero-sprite--light { opacity: 1; }

  /* background-position-y in % maps over (bg-height - container-height).
     With bg-height = 5×, container = 1×, range = 4×. So:
       0%   → frame 0 (empty)
       25%  → frame 1 (t)
       50%  → frame 2 (te)
       75%  → frame 3 (ter)
       100% → frame 4 (term) */
  @keyframes hero-sprite {
    0% { background-position: 0% 0%; }
    22% { background-position: 0% 25%; }
    27% { background-position: 0% 50%; }
    32% { background-position: 0% 75%; }
    43% { background-position: 0% 100%; }
    94% { background-position: 0% 0%; }
  }

  /* Reduced motion — freeze on the empty state. */
  @media (prefers-reduced-motion: reduce) {
    .hero-sprite {
      animation: none !important;
      background-position: 0% 0%;
    }
  }
</style>

<script>
  // Scroll parallax for the decorative hero layer. Each element carries a
  // data-depth factor (bigger icons sit "closer" and move more; the glow
  // gets a small negative depth so it drifts the other way). We only touch
  // a CSS custom property per frame — the transform composition lives in
  // CSS — and throttle to one update per animation frame. Disabled wholesale
  // for users who prefer reduced motion.
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>(".hero-icons__app, .hero-glow"),
    );
    if (!nodes.length) return;

    const items = nodes.map((el) => ({
      el,
      depth: parseFloat(el.dataset.depth || "0"),
    }));

    let ticking = false;
    function apply() {
      const y = window.scrollY;
      for (const { el, depth } of items) {
        el.style.setProperty("--py", `${(y * depth).toFixed(1)}px`);
      }
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(apply);
      }
    }

    apply();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
