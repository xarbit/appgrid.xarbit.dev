---
import { Picture } from "astro:assets";
import heroLight0 from "../assets/screenshots/launcher-empty.png";
import heroLight1 from "../assets/screenshots/launcher-t.png";
import heroLight2 from "../assets/screenshots/launcher-te.png";
import heroLight3 from "../assets/screenshots/launcher-ter.png";
import heroLight4 from "../assets/screenshots/launcher-term.png";
import heroDark0 from "../assets/screenshots/launcher-dark-empty.png";
import heroDark1 from "../assets/screenshots/launcher-dark-t.png";
import heroDark2 from "../assets/screenshots/launcher-dark-te.png";
import heroDark3 from "../assets/screenshots/launcher-dark-ter.png";
import heroDark4 from "../assets/screenshots/launcher-dark-term.png";
import BrandIcon from "./BrandIcon.astro";
import {
  primary,
  mirrors,
  repoUrl,
  fetchLatestVersion,
  fetchLatestPrerelease,
  fetchStars,
  formatStars,
} from "../config/repo";

const stable = await fetchLatestVersion(primary);
const prerelease = await fetchLatestPrerelease(primary);
const starsCount = await fetchStars(primary);
const starsLabel = starsCount !== null ? formatStars(starsCount) : null;

// Distros we package for (count by hand to match install section).
const distrosPackaged = 6; // Arch, Fedora, Ubuntu, Debian, openSUSE, Gentoo
const distrosImmutable = 6; // KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS
---

<section class="relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-6">
        {
          stable && (
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3daee9]/10 border border-[#3daee9]/30 text-[#93cee9] text-xs font-medium">
              <span class="w-2 h-2 rounded-full bg-[#3daee9] animate-pulse" />
              stable: v{stable}
            </span>
          )
        }
        {
          prerelease && (
            <a
              href={prerelease.htmlUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e67e22]/10 border border-[#e67e22]/40 text-[#f5a35e] text-xs font-medium hover:bg-[#e67e22]/20 transition-colors"
              title="Pre-release available — click for release notes"
            >
              <span class="w-2 h-2 rounded-full bg-[#e67e22] animate-pulse" />
              pre-release: v{prerelease.tag}
            </a>
          )
        }
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6"
      >
        Application launcher
        <span class="block">
          <span
            class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
          >
            built for
          </span>
          <span class="inline-flex items-center gap-3 align-middle">
            <BrandIcon
              slug="kdeplasma"
              size={56}
              brandColor
              title="KDE Plasma"
              class="hero-kde-mark"
            />
            <span
              class="bg-gradient-to-r from-[#3daee9] to-[#9b59b6] bg-clip-text text-transparent"
            >
              KDE Plasma 6
            </span>
          </span>
        </span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--fg-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
        A grid-style replacement for Kickoff and Kicker with unified search,
        KRunner integration and smooth animations. Packaged for Arch, Fedora,
        Ubuntu, Debian and openSUSE, plus a universal <code>~/.local/</code>
        tarball that runs on any Plasma 6.4+ system, immutable distros included
        (KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS).
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Install AppGrid
        </a>
        <a
          href={repoUrl(primary)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
          View on {primary.label}
        </a>
      </div>

      {
        mirrors.length > 0 && (
          <div class="mt-3 text-xs text-[var(--fg-muted)]">
            Also on{" "}
            {mirrors.map((m, i) => (
              <>
                {i > 0 && ", "}
                <a
                  href={repoUrl(m)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-[var(--fg)]"
                >
                  {m.label}
                </a>
              </>
            ))}
          </div>
        )
      }

      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto">
        {starsLabel && (
          <a
            href={repoUrl(primary)}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[#f1c40f]/40 transition-colors group"
          >
            <div class="flex items-center gap-1.5 text-[#f4d03f]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">{starsLabel}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">{primary.label} stars</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#3daee9]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16.5 9.4 7.5 4.21" />
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
            <span class="font-semibold text-[var(--fg)] tabular-nums">{distrosPackaged + distrosImmutable}+</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">distros supported</span>
        </div>

        {stable && (
          <a
            href="#whats-new"
            class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)] hover:border-[var(--color-breeze-blue)]/40 transition-colors"
          >
            <div class="flex items-center gap-1.5 text-[#5fd48a]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="font-semibold text-[var(--fg)] tabular-nums">v{stable}</span>
            </div>
            <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">latest stable</span>
          </a>
        )}

        <div class="flex flex-col items-center gap-1 p-3 rounded-lg border border-[var(--border)] bg-[var(--card)]">
          <div class="flex items-center gap-1.5 text-[#c084d6]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 12l2 2 4-4" />
              <circle cx="12" cy="12" r="10" />
            </svg>
            <span class="font-semibold text-[var(--fg)]">GPL-2.0</span>
          </div>
          <span class="text-xs text-[var(--fg-muted)] uppercase tracking-wide">free &amp; open</span>
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20 relative">
      <div
        class="absolute -inset-x-10 -inset-y-6 bg-gradient-to-b from-[#3daee9]/20 via-[#9b59b6]/10 to-transparent blur-3xl -z-10"
      >
      </div>
      <div class="hero-demo mx-auto drop-shadow-2xl" aria-label="AppGrid demo: typing 'term' in the search bar, then launching Ghostty">
        <!-- 5 frames per theme, stacked. Opacity-animated so the right
             frame is visible at each keystroke window. Aspect-ratio on
             the parent reserves layout; absolute children avoid CLS. -->
        <Picture
          src={heroDark0}
          alt="AppGrid launcher with empty search (dark theme)"
          loading="eager"
          decoding="sync"
          widths={[640, 960, 1208]}
          sizes="(max-width: 768px) 100vw, 1100px"
          quality={90}
          formats={["avif", "webp"]} fallbackFormat="webp"
          pictureAttributes={{ class: "hero-frame-wrap" }}
          class="hero-frame hero-frame--dark hero-frame--0"
        />
        <Picture src={heroDark1} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--dark hero-frame--1" />
        <Picture src={heroDark2} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--dark hero-frame--2" />
        <Picture src={heroDark3} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--dark hero-frame--3" />
        <Picture src={heroDark4} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--dark hero-frame--4" />

        <Picture src={heroLight0} alt="AppGrid launcher with empty search (light theme)" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--light hero-frame--0" />
        <Picture src={heroLight1} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--light hero-frame--1" />
        <Picture src={heroLight2} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--light hero-frame--2" />
        <Picture src={heroLight3} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--light hero-frame--3" />
        <Picture src={heroLight4} alt="" loading="eager" decoding="sync" widths={[640, 960, 1208]} sizes="(max-width: 768px) 100vw, 1100px" quality={90} formats={["avif", "webp"]} fallbackFormat="webp" pictureAttributes={{ class: "hero-frame-wrap" }} class="hero-frame hero-frame--light hero-frame--4" />

        <!-- Animation overlay. All coordinates are % of the rendered
             image bounds so they scale. Tune --search-* and --ghostty-*
             if the underlying screenshots change. -->
        <div class="hero-overlay" aria-hidden="true">
          <!-- Click pulse over Ghostty (first result row, Alt+1). -->
          <span class="hero-pulse hero-pulse--search"></span>
          <span class="hero-pulse hero-pulse--ghostty"></span>

          <!-- Synthetic cursor — white fill + black stroke for both themes. -->
          <svg class="hero-cursor" viewBox="0 0 24 24" width="22" height="22">
            <path d="M3 2 L3 18 L7 14 L10 21 L13 19.5 L10 13 L16 13 Z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* H1 KDE Plasma brand mark — scale down on small viewports so it
     visually balances the smaller H1 font size. */
  .hero-kde-mark {
    width: 2.5rem;
    height: 2.5rem;
  }
  @media (min-width: 768px) {
    .hero-kde-mark {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  /* ─────────────────────── Scripted hero demo ─────────────────────── */
  /* The five frames per theme are stacked inside .hero-demo and shown
     in sequence via per-frame opacity keyframes. Coordinates of the
     synthetic cursor + click pulses are % of the container so they
     scale at every responsive width. Tune --search-* / --ghostty-* if
     the underlying screenshots change. */
  .hero-demo {
    position: relative;
    width: 100%;
    max-width: 1208px;
    aspect-ratio: 1208 / 966;
    /* Container queries so child elements (cursor, pulses) can size
       in cqw — % of the demo's own width — and scale on every viewport. */
    container-type: inline-size;
    /* Search bar click target. */
    --search-x: 50%;
    --search-y: 3.5%;
    /* First result row centre (Ghostty after typing "term"). */
    --ghostty-x: 50%;
    --ghostty-y: 11%;
    /* Cursor offscreen start. */
    --start-x: 108%;
    --start-y: -8%;
  }

  /* <Picture> wraps the img in <picture>. display:contents removes
     the wrapper from the layout tree so the existing absolute-position
     CSS on .hero-frame (the img inside) keeps working. */
  .hero-frame-wrap {
    display: contents;
  }

  /* Theme separation — hide opposite set entirely. */
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    /* GPU promote each frame so opacity flips don't trigger layout
       and don't cause flicker while the next frame decodes. */
    will-change: opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  /* Default to dark; system pref toggles when no explicit theme set. */
  .hero-frame--light { display: none; }
  @media (prefers-color-scheme: light) {
    html:not([data-theme]) .hero-frame--dark { display: none; }
    html:not([data-theme]) .hero-frame--light { display: block; }
  }
  html[data-theme="dark"] .hero-frame--dark { display: block; }
  html[data-theme="dark"] .hero-frame--light { display: none; }
  html[data-theme="light"] .hero-frame--dark { display: none; }
  html[data-theme="light"] .hero-frame--light { display: block; }

  /* Per-frame opacity timeline (9s loop). Letter cadence is uneven —
     "t" and "e" fire fast, "r" and "m" fire slow, mimicking a user
     who hesitates before the less common letters.
       0–22%    frame 0 (empty)  — initial dwell + cursor enters
       22–27%   frame 1 (t)      — fast (≈0.45s)
       27–32%   frame 2 (te)     — fast (≈0.45s)
       32–43%   frame 3 (ter)    — slow (≈1.0s)
       43–93%   frame 4 (term)   — slow arrival, then dwell + click
       94–100%  frame 0 (reset)  — after cursor offscreen */
  .hero-frame--0 { animation: hero-frame-0 9s linear infinite; }
  .hero-frame--1 { animation: hero-frame-1 9s linear infinite; }
  .hero-frame--2 { animation: hero-frame-2 9s linear infinite; }
  .hero-frame--3 { animation: hero-frame-3 9s linear infinite; }
  .hero-frame--4 { animation: hero-frame-4 9s linear infinite; }

  @keyframes hero-frame-0 {
    0%, 21.5% { opacity: 1; }
    22%, 93.5% { opacity: 0; }
    94%, 100% { opacity: 1; }
  }
  @keyframes hero-frame-1 {
    0%, 21.5% { opacity: 0; }
    22%, 26.5% { opacity: 1; }
    27%, 100% { opacity: 0; }
  }
  @keyframes hero-frame-2 {
    0%, 26.5% { opacity: 0; }
    27%, 31.5% { opacity: 1; }
    32%, 100% { opacity: 0; }
  }
  @keyframes hero-frame-3 {
    0%, 31.5% { opacity: 0; }
    32%, 42.5% { opacity: 1; }
    43%, 100% { opacity: 0; }
  }
  @keyframes hero-frame-4 {
    0%, 42.5% { opacity: 0; }
    43%, 93.5% { opacity: 1; }
    94%, 100% { opacity: 0; }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Synthetic cursor — animate top/left so % resolves against the
     container, not the cursor itself. Size in cqw so the cursor
     scales with the demo width (so it doesn't look tiny in fullscreen
     and oversized on mobile). Clamp keeps it in a sane range. */
  .hero-cursor {
    position: absolute;
    top: var(--start-y);
    left: var(--start-x);
    width: clamp(18px, 3cqw, 44px);
    height: clamp(18px, 3cqw, 44px);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
    animation: hero-cursor-path 9s cubic-bezier(0.6, 0.05, 0.4, 1) infinite;
  }

  @keyframes hero-cursor-path {
    /* Hold offscreen for the initial dwell (0–8%) */
    0%, 8% {
      top: var(--start-y);
      left: var(--start-x);
    }
    /* Enter and arrive at search bar by 22% — frame 1 (t) shows at 24% */
    22% {
      top: var(--search-y);
      left: var(--search-x);
    }
    /* Dwell at search bar while typing (22–55%) */
    55% {
      top: var(--search-y);
      left: var(--search-x);
    }
    /* Move down to Ghostty result row (arrives ~70%) */
    70% {
      top: var(--ghostty-y);
      left: var(--ghostty-x);
    }
    /* Click + dwell on Ghostty (70–86%) */
    86% {
      top: var(--ghostty-y);
      left: var(--ghostty-x);
    }
    /* Cursor exits the window (must complete BEFORE frame reset at 94%) */
    93%, 100% {
      top: var(--start-y);
      left: var(--start-x);
    }
  }

  /* Click pulse — two independent rings firing at search-bar click
     and at Ghostty click. */
  .hero-pulse {
    position: absolute;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 2px solid var(--color-breeze-blue, #3daee9);
    background: rgba(61, 174, 233, 0.18);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }

  .hero-pulse--search {
    left: var(--search-x);
    top: var(--search-y);
    width: 5%;
    animation: hero-pulse-anim 9s linear infinite;
    animation-delay: 1.98s;  /* fires at search-bar click (~22% of 9s) */
  }

  .hero-pulse--ghostty {
    left: var(--ghostty-x);
    top: var(--ghostty-y);
    width: 8%;
    animation: hero-pulse-anim 9s linear infinite;
    animation-delay: 6.3s;   /* fires at Ghostty click (~70% of 9s) */
  }

  @keyframes hero-pulse-anim {
    0% {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 0.9;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
  }

  /* Reduced motion — freeze on the empty state, hide cursor + pulses. */
  @media (prefers-reduced-motion: reduce) {
    .hero-frame, .hero-cursor, .hero-pulse {
      animation: none !important;
    }
    .hero-frame--0 { opacity: 1; }
    .hero-frame:not(.hero-frame--0) { opacity: 0; }
    .hero-pulse { opacity: 0; }
    .hero-cursor {
      top: var(--start-y);
      left: var(--start-x);
    }
  }
</style>
