---
import { primary, repoUrl, fetchStars, formatStars } from "../config/repo";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#screenshots", label: "Screenshots" },
  { href: "/#shortcuts", label: "Shortcuts" },
  { href: "/#install", label: "Install" },
  { href: "/docs", label: "Docs" },
  { href: "/#contribute", label: "Contribute" },
  { href: "/#faq", label: "FAQ" },
];

const starsCount = await fetchStars(primary);
const stars = starsCount !== null ? formatStars(starsCount) : null;
---

<nav class="sticky top-0 z-50 px-6 pt-3 md:pt-4">
  <div class="max-w-6xl mx-auto">
    <div class="px-4 md:px-5 h-14 flex items-center justify-between gap-4 rounded-lg border border-[var(--border)] nav-bg backdrop-blur-md shadow-lg">
    <a href="/" class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-fg shrink-0 whitespace-nowrap">
      <Logo size={28} />
      <span>AppGrid <span class="hidden sm:inline text-fg-muted font-normal">for Plasma</span></span>
    </a>

    <div class="hidden lg:flex items-center gap-6 text-sm text-fg-muted">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hover:text-fg transition-colors"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <button
        id="nav-hamburger"
        type="button"
        class="btn-icon lg:hidden"
        aria-label="Open menu"
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <svg id="nav-hamburger-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="nav-hamburger-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"/>
          <line x1="18" y1="6" x2="6" y2="18"/>
        </svg>
      </button>


      <a
        href={repoUrl(primary)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-sm py-2 px-3"
        aria-label={stars ? `Star on ${primary.label} — ${stars} stars` : `Star on ${primary.label}`}
      >
        {
          primary.platform === "github" ? (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
          ) : (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22a4.5 4.5 0 0 1 .12-3.18s1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 0z" />
            </svg>
          )
        }
        <span>Star</span>
        {
          stars && (
            <>
              <span class="mx-1 h-4 w-px bg-white/30" aria-hidden="true" />
              <span class="flex items-center gap-1 tabular-nums">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
                {stars}
              </span>
            </>
          )
        }
      </a>
    </div>
  </div>

    <!-- Mobile drawer — floats just under the pill, same width + radius. -->
    <div
      id="nav-drawer"
      class="lg:hidden hidden mt-2 rounded-lg border border-[var(--border)] nav-bg backdrop-blur-md shadow-lg overflow-hidden"
    >
      <ul class="px-4 py-2 flex flex-col">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-drawer-link block py-2.5 text-sm text-[var(--fg-body)] hover:text-[var(--color-breeze-blue)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-hamburger");
    var drawer = document.getElementById("nav-drawer");
    var iconOpen = document.getElementById("nav-hamburger-open");
    var iconClose = document.getElementById("nav-hamburger-close");
    if (!btn || !drawer || !iconOpen || !iconClose) return;

    function setOpen(open) {
      drawer.classList.toggle("hidden", !open);
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    btn.addEventListener("click", function () {
      setOpen(drawer.classList.contains("hidden"));
    });

    // Auto-close when a drawer link is clicked (e.g. anchor jump on same page).
    drawer.querySelectorAll(".nav-drawer-link").forEach(function (a) {
      a.addEventListener("click", function () { setOpen(false); });
    });

    // Auto-close if the viewport grows past the lg breakpoint (1024px) while open.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) {
      if (e.matches) setOpen(false);
    });

    // Click outside the nav closes the drawer.
    document.addEventListener("click", function (e) {
      if (drawer.classList.contains("hidden")) return;
      var nav = btn.closest("nav");
      if (nav && !nav.contains(e.target)) setOpen(false);
    });
  })();
</script>
