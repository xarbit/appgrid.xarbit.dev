---
import BrandIcon from "./BrandIcon.astro";

const features = [
  {
    title: "Unified search",
    desc: "App results and KRunner results in one list. Alt+1–9 to launch by position. Search by keyword (\"browser\" finds Firefox) or install source (\"flatpak\", \"snap\", \"web app\").",
    icon: "search",
  },
  {
    title: "Smart ranking",
    desc: "Best name match wins (prefix > substring > generic > keyword). Your mime defaults — default browser, default editor — rank above peers in the same tier. Most-launched apps bump up.",
    icon: "sparkles",
  },
  {
    title: "Quick commands",
    desc: "Terminal (t:), shell (:), file browser (/), system info (i:), hidden apps (h:), help (?). Each prefix opens a focused view.",
    icon: "terminal",
  },
  {
    title: "Application actions",
    desc: "Right-click any app for jumplist actions (e.g., New Private Window, New Document) sourced from its .desktop file.",
    icon: "mouse",
  },
  {
    title: "Hide apps you don't want",
    desc: "Right-click → Hide Application to remove anything you never launch from the grid. Type h: to see the hidden list and unhide with one click. Per-user, never touches system .desktop files.",
    icon: "eye-off",
  },
  {
    title: "Two variants",
    desc: "AppGrid (Center) — standalone window with its own blur, opacity, corner radius. AppGrid (Panel) — native Plasma popup anchored to the panel icon, Kickoff-style.",
    icon: "layout",
  },
  {
    title: "Favorites & categories",
    desc: "Reorder favorites by drag-and-drop or Ctrl+Shift+arrow. By-category view with Alt+key mnemonics, backed by either AppGrid's built-in mapping or KDE Menu Editor.",
    icon: "star",
  },
  {
    title: "Drag & drop everywhere",
    desc: "Drag apps from any view (All, Favorites, By Category) onto your panel, desktop, or the Favorites strip. Drag within Favorites to reorder them.",
    icon: "drag",
    badge: "New in 1.8.0",
  },
  {
    title: "Recent activity",
    desc: "Launches are broadcast to KActivities so apps you start through AppGrid show up in Plasma's system-wide recent activity (Activity Switcher, KRunner).",
    icon: "activity",
    badge: "New in 1.8.0",
  },
  {
    title: "Animations",
    desc: "Open/close: Fade, Scale, Pop, Slide Up/Down, Glide, Buzz, Twist, Slam, Grow Up. On-hover icon: Shake, Grow, Bounce, Spin, Shuffle. Respects your system animation speed.",
    icon: "play",
  },
  {
    title: "Customizable",
    desc: "Grid size, icon size, blur, opacity, corner radius, dividers, tooltips, session buttons, category bar, recents row, label visibility — all per-variant.",
    icon: "sliders",
  },
  {
    title: "Plasma-native",
    desc: "Respects system animation speed, font size, accent colour and Plasma theme corner radius. Built on KDE Frameworks 6 (Kirigami, KIO, KRunner, Plasma, KService, KIconThemes and friends) — the same building blocks the rest of your desktop uses.",
    icon: "brand:kdeplasma",
  },
  {
    title: "Drop-in replacement",
    desc: "Replace Kickoff or Kicker via Plasma's Show Alternatives. One click, no config edits.",
    icon: "replace",
  },
  {
    title: "Universal Package",
    desc: "User-local ~/.local/ install for any Plasma 6.4+ system. Primary path for immutable distros (KDE Linux, Kinoite, Bazzite, Aurora, Kalpa, SteamOS), available for any other distro too. No root, survives rebases.",
    icon: "package",
    badge: "New in 1.8.0",
  },
  {
    title: "Update indicator",
    desc: "Universal-build only, opt-in: shows a small indicator near the session buttons when a new release is out. One anonymous HTTPS request per day, no telemetry. Distro packages let your package manager handle updates.",
    icon: "bell",
    badge: "New in 1.8.0",
  },
];

const icons: Record<string, string> = {
  search:
    '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  layout:
    '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  sparkles:
    '<path d="M12 3l1.9 5.8L19.5 10l-5.6 1.5L12 17l-1.9-5.5L4.5 10l5.6-1.2L12 3z"/>',
  package:
    '<path d="M16.5 9.4 7.5 4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  mouse: '<rect x="6" y="3" width="12" height="18" rx="6"/><line x1="12" y1="7" x2="12" y2="11"/>',
  play: '<polygon points="5 3 19 12 5 21 5 3"/>',
  monitor:
    '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
  sliders:
    '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  paintbrush:
    '<path d="M18.37 2.63 14 7l-3-3 4.37-4.37a2 2 0 0 1 2.83 0l.17.17a2 2 0 0 1 0 2.83z"/><path d="M9 8l-7 7v5h5l7-7"/>',
  replace:
    '<polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
  shield:
    '<path d="M12 2l9 4v6c0 5-3.5 9.5-9 10-5.5-.5-9-5-9-10V6l9-4z"/>',
  drag:
    '<polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/>',
  activity:
    '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  bell:
    '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
  "eye-off":
    '<path d="M9.88 9.88a3 3 0 0 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/>',
};
---

<section id="features" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
        Built for daily use
      </h2>
      <p class="text-lg text-[var(--fg-muted)]">
        Search, launch, drag, customize — the things you'll actually touch.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        features.map((f) => (
          <div class="breeze-card p-6 group transition-transform duration-300 hover:-translate-y-0.5 hover:border-[var(--color-breeze-blue)]/40">
            <div class="w-10 h-10 rounded-lg bg-[#3daee9]/15 border border-[#3daee9]/30 grid place-items-center text-[#3daee9] mb-4 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
              {f.icon.startsWith("brand:") ? (
                <BrandIcon slug={f.icon.slice("brand:".length)} size={20} />
              ) : (
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[f.icon]}
                />
              )}
            </div>
            <h3 class="text-lg font-semibold mb-1.5 flex items-center gap-2">
              {f.title}
              {f.badge && (
                <span class="px-1.5 py-0.5 text-[10px] rounded uppercase tracking-wide bg-[#e67e22]/20 text-[#f5a35e] border border-[#e67e22]/40">
                  {f.badge}
                </span>
              )}
            </h3>
            <p class="text-sm text-[var(--fg-muted)] leading-relaxed">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
