---
const navigation = [
  { keys: ["Super"], desc: "Toggle AppGrid" },
  { keys: ["Esc"], desc: "Close" },
  { keys: ["↑", "↓", "←", "→"], desc: "Navigate results", separator: " " },
  { keys: ["Enter"], desc: "Launch top result" },
  { keys: ["Tab"], desc: "Cycle apps + runners" },
  { keys: ["Alt", "1-9"], desc: "Launch by number" },
  { keys: ["Alt", "letter"], desc: "Jump to category" },
  {
    keys: ["Alt", "←→"],
    desc: "Step through categories",
    badge: "New in 1.8.0",
  },
  {
    keys: ["Ctrl", "Shift", "↑↓←→"],
    desc: "Move favorite by one cell",
    badge: "New in 1.8.0",
  },
];

const selection = [
  { keys: ["Ctrl", "click"], desc: "Toggle selection of clicked app" },
  { keys: ["Shift", "click"], desc: "Range-select from anchor to click" },
  { keys: ["Space"], desc: "Toggle selection on focused app" },
  { keys: ["Shift", "↑↓←→"], desc: "Extend range selection" },
  { keys: ["Ctrl", "A"], desc: "Select all in current view" },
  { keys: ["Delete"], desc: "Remove selected from Favorites" },
  { keys: ["Esc"], desc: "Clear selection" },
];

const commands = [
  { trigger: "t:command", desc: "Run in terminal" },
  { trigger: ":command", desc: "Run shell command" },
  { trigger: "/path", desc: "Browse files" },
  { trigger: "~/path", desc: "Browse home" },
  { trigger: "i:", desc: "System info (copyable)" },
  { trigger: "h:", desc: "Hidden apps manager" },
  { trigger: "?", desc: "Show quick commands help" },
];

// Decorative scattered keycaps behind the section heading (Raycast-style).
// `w` is a width multiplier (1 = square keycap); x/y are % positions;
// `rot` is degrees. Kept out of the centre band so heading text stays
// crisp; the layer is masked + faded so it never competes with the cards.
const decoKeys = [
  { label: "Super", x: "6%", y: "14%", w: 1.9, rot: -9 },
  { label: "Esc", x: "84%", y: "9%", w: 1.4, rot: 8 },
  { label: "Tab", x: "17%", y: "58%", w: 1.5, rot: -6 },
  { label: "↵", x: "92%", y: "44%", w: 1, rot: 5 },
  { label: "Ctrl", x: "73%", y: "70%", w: 1.6, rot: -7 },
  { label: "↑", x: "44%", y: "6%", w: 1, rot: -4 },
  { label: "Alt", x: "30%", y: "22%", w: 1.4, rot: 7 },
  { label: "Shift", x: "60%", y: "20%", w: 1.8, rot: -5 },
  { label: "Space", x: "47%", y: "76%", w: 2.4, rot: 4 },
  { label: "←", x: "3%", y: "62%", w: 1, rot: 10 },
  { label: "→", x: "95%", y: "76%", w: 1, rot: -8 },
  { label: "↓", x: "38%", y: "46%", w: 1, rot: 6 },
  { label: "A", x: "88%", y: "26%", w: 1, rot: -10 },
  { label: "?", x: "12%", y: "36%", w: 1, rot: 5 },
  { label: "/", x: "24%", y: "9%", w: 1, rot: 6 },
  { label: "1", x: "67%", y: "8%", w: 1, rot: -7 },
  { label: "9", x: "81%", y: "42%", w: 1, rot: 9 },
  { label: "Del", x: "9%", y: "50%", w: 1.5, rot: -6 },
  { label: ":", x: "54%", y: "54%", w: 1, rot: 5 },
  { label: "i:", x: "25%", y: "74%", w: 1, rot: -8 },
  { label: "Fn", x: "90%", y: "58%", w: 1.2, rot: 7 },
  { label: "F2", x: "64%", y: "38%", w: 1.2, rot: -5 },
  { label: "h:", x: "79%", y: "86%", w: 1, rot: 8 },
  { label: "~", x: "34%", y: "84%", w: 1, rot: -6 },
  { label: "Meta", x: "51%", y: "33%", w: 1.7, rot: 6 },
  { label: "Enter", x: "15%", y: "84%", w: 1.7, rot: 9 },
  { label: "↹", x: "70%", y: "54%", w: 1, rot: -9 },
  { label: "Ctrl", x: "40%", y: "62%", w: 1.6, rot: 7 },
];
---

<section
  id="shortcuts"
  class="relative overflow-hidden py-20 md:py-28 border-t border-[var(--border)]/50"
>
  <!-- Decorative scattered keycaps behind the heading. Purely visual —
       masked + faded so it never reduces card legibility. -->
  <div class="kbd-deco" aria-hidden="true">
    {
      decoKeys.map((k) => (
        <span
          class="kbd-deco__key"
          style={`left:${k.x};top:${k.y};--kw:${k.w};--rot:${k.rot}deg;`}
        >
          {k.label}
        </span>
      ))
    }
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
        Made for the keyboard too
      </h2>
      <p class="text-lg text-[var(--fg-muted)]">
        Search, switch tabs, reorder favorites, launch — all keyable.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="breeze-card p-6">
        <h3 class="text-base font-semibold mb-4 flex items-center gap-2">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-[var(--color-breeze-blue)]"
          >
            <rect x="3" y="6" width="18" height="12" rx="2"></rect>
            <path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10"></path>
          </svg>
          Navigation
        </h3>
        <ul class="space-y-3">
          {
            navigation.map((row) => (
              <li class="flex items-center justify-between gap-4 text-sm">
                <span class="text-[var(--fg-body)] flex items-center gap-2 flex-wrap">
                  {row.desc}
                  {row.badge && (
                    <span class="px-1.5 py-0.5 text-[10px] rounded uppercase tracking-wide bg-[#e67e22]/20 text-[#f5a35e] border border-[#e67e22]/40">
                      {row.badge}
                    </span>
                  )}
                </span>
                <span class="flex items-center gap-1 flex-shrink-0">
                  {row.keys.map((k, i) => (
                    <>
                      {i > 0 && !row.separator && (
                        <span class="text-[var(--fg-subtle)] text-xs">+</span>
                      )}
                      {i > 0 && row.separator && <span>{row.separator}</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="breeze-card p-6">
        <h3 class="text-base font-semibold mb-4 flex items-center gap-2">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-[#f5a35e]"
          >
            <path d="M21 3H3v18h18V3z"></path>
            <path d="M7 7h4v4H7zM13 7h4v4h-4zM7 13h4v4H7zM13 13h4v4h-4z"></path>
          </svg>
          Multi-select
          <span class="px-1.5 py-0.5 text-[10px] rounded uppercase tracking-wide bg-[#e67e22]/20 text-[#f5a35e] border border-[#e67e22]/40 font-normal">
            New in 1.8.0
          </span>
        </h3>
        <p class="text-xs text-[var(--fg-muted)] mb-4">
          Build a selection in Favorites, All, or by-Category — then drag, pin, launch, or remove the whole batch at once.
        </p>
        <ul class="space-y-3">
          {
            selection.map((row) => (
              <li class="flex items-center justify-between gap-4 text-sm">
                <span class="text-[var(--fg-body)]">{row.desc}</span>
                <span class="flex items-center gap-1 flex-shrink-0">
                  {row.keys.map((k, i) => (
                    <>
                      {i > 0 && (
                        <span class="text-[var(--fg-subtle)] text-xs">+</span>
                      )}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="breeze-card p-6">
        <h3 class="text-base font-semibold mb-4 flex items-center gap-2">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-[var(--color-breeze-blue)]"
          >
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          Quick commands
        </h3>
        <p class="text-xs text-[var(--fg-muted)] mb-4">
          Type these in the search bar to switch modes.
        </p>
        <ul class="space-y-3">
          {
            commands.map((cmd) => (
              <li class="flex items-center justify-between gap-4 text-sm">
                <span class="text-[var(--fg-body)]">{cmd.desc}</span>
                <kbd class="kbd font-mono">{cmd.trigger}</kbd>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scattered-keycap decoration behind the section heading. Covers the
     top band only; a vertical mask fades it out before the cards so
     legibility is never affected. Colours come from theme tokens, so
     it adapts to light/dark automatically. */
  .kbd-deco {
    position: absolute;
    inset: 0 0 auto 0;
    height: 440px;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.85) 48%,
      transparent 90%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.85) 48%,
      transparent 90%
    );
  }

  .kbd-deco__key {
    position: absolute;
    display: grid;
    place-items: center;
    height: 2.6rem;
    width: calc(2.6rem * var(--kw, 1));
    padding: 0 0.5rem;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-muted);
    font:
      600 0.9rem/1 "Noto Sans",
      system-ui,
      sans-serif;
    white-space: nowrap;
    /* Keycap depth — a hard lower edge plus a soft cast shadow. */
    box-shadow:
      0 3px 0 0 color-mix(in srgb, var(--border) 75%, transparent),
      0 5px 10px rgba(0, 0, 0, 0.18);
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    opacity: 0.5;
    user-select: none;
  }

  @media (min-width: 768px) {
    .kbd-deco {
      height: 480px;
    }
    .kbd-deco__key {
      height: 3rem;
      width: calc(3rem * var(--kw, 1));
      font-size: 1rem;
    }
  }
</style>
